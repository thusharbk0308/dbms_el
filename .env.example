# ========================================================
# ChainProof Environment Variables Configuration
# ========================================================

# Server Configuration
PROJECT_NAME="ChainProof"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="chainproof_super_secret_jwt_key_replace_in_production_min32chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration (PostgreSQL default; supports SQLite for testing/local dev)
# For local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chainproof"
# For Docker Compose:
# DATABASE_URL="postgresql://postgres:postgres@db:5432/chainproof"
# For SQLite (zero-config local run):
# DATABASE_URL="sqlite:///./chainproof.db"

# Storage Configuration
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=25

# Blockchain Configuration (Hardhat / Local RPC node)
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
BLOCKCHAIN_NETWORK_NAME="hardhat_local"
CHAIN_ID=31337
CONTRACT_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"
DEPLOYER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
